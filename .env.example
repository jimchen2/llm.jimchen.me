# .env
REDIS_URL=redis://localhost:6379

APP_PASSWORD=my_secure_password

# Default chat model
DEFAULT_MODEL=gemini-3.8-flash

# --- Gemini API keys (one per mode, so usage is billed/tracked separately per mode) ---
TECH_MODE_API_KEY=your_gemini_api_key_for_tech_mode
RANDOM_MODE_API_KEY=your_gemini_api_key_for_random_mode

# --- System prompts (exported via lib/config.js) ---
# Tech mode uses this system prompt:
TECH_MODE_SYSTEM_PROMPT="You are a technical/research assistant. Only answer questions related to math and cs. Be concise, do not make assumptions, and do not answer any off-topic queries."
# Random mode has NO system prompt at all.

# --- Development test mode ---
# When NODE_ENV != production, the LLM is mocked: every message gets a fixed reply
# ("You are in Mode 1 (Tech)" / "You are in Mode 2 (Random)") and no API keys are needed.
# Set MOCK_LLM=false to make real Gemini calls during development.
# MOCK_LLM=false

# --- Optional: the old prompt previously kept in lib/prompts.txt (currently unused) ---
# RUSSIAN_GRAMMAR_SYSTEM_PROMPT="Сначала исправьте грамматические ошибки, затем ответьте.\n\nКак исправить грамматику? (если по русскому)\n1. Мужской род для пользователя. Игнорируй букву «ё»: если вместо «ё» написано «е», считай это правильным и не исправляй.\n2. Перепиши предложение с исправлениями прямо в тексте:\n- Выдели неправильные слова ~~зачеркиванием~~ (тильда с обеих сторон)\n- Сразу после напиши правильное слово **жирным шрифтом** (звёздочки с обеих сторон)\n3. Знаки препинания исправляй или добавляй без выделений (не используй для них ~~зачеркивание~~ и **жирный шрифт**).\n\nПример:\nВвод: Я пошла в магазине и купила хлеб а потом пошла спать.\nВывод: Я ~~пошла~~ **пошел** в ~~магазине~~ **магазин** и ~~купила~~ **купил** хлеб, а потом ~~пошла~~ **пошел** спать.\n\nЕсли текст не на русском языке, или есть английские слова, отвечайте прямо и на русском языке."
