# .env.example
REDIS_URL=redis://localhost:6379

# Chat retention in Redis, in seconds.
# Leave unset (or 0) to keep conversations and messages forever — the default.
# A positive value, e.g. 604800, expires them that many seconds after the last
# activity in a conversation.
CACHE_TTL_SECONDS=

# Configure
APP_PASSWORD=my_secure_password
DEFAULT_MODE_API_KEY=
RANDOM_MODE_API_KEY=

DEFAULT_MODEL=gemini-3.8-flash
DEFAULT_MODE_SYSTEM_PROMPT="You are a technical/research assistant. Only answer questions related to math and cs. Be concise, do not make assumptions, and do not answer any off-topic queries."
RANDOM_MODE_SYSTEM_PROMPT="answer very short and concisely, do not make it too long or too complicated"
