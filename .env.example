# .env — copy this file to `.env` and fill in your own values.
REDIS_URL=redis://localhost:6379

APP_PASSWORD=my_secure_password

# Server-side Gemini API key. Used automatically when the client does not
# provide its own key in Settings (client key, if set, takes precedence).
GEMINI_API_KEY=your_gemini_api_key_here

# Default model used when the client has not chosen one.
DEFAULT_MODEL=gemini-3.8-flash

# System prompt for "tech" mode. "random" mode uses no system prompt at all.
TECH_SYSTEM_PROMPT=You are a technical/research assistant. Only answer questions related to math and cs. Be concise, do not make assumptions, and do not answer any off-topic queries.
