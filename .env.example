# ---------------------------------------------------------------------------
# llm.jimchen.me — copy this file and fill in what you need:
#
#     cp .env.example .env
#
# In development (`npm run dev`) nothing here is required: without a Gemini key
# the server answers with a fixed mock message that tells you which mode you are
# in, and no password is asked for.
# ---------------------------------------------------------------------------

# --- Redis (stores conversations + messages) -------------------------------
REDIS_URL=redis://localhost:6379
# Development only: force the in-process store instead of Redis.
# REDIS_DRIVER=memory
CACHE_TTL_SECONDS=86400

# --- Single-user access password -------------------------------------------
APP_PASSWORD=my_secure_password
# Development never asks for the password. Set this to true if you want to test
# the real login flow while running the dev server.
# DEV_REQUIRE_AUTH=true

# --- Models ----------------------------------------------------------------
# Default model used by both modes. The default is gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Optional per-mode model overrides (leave empty to use GEMINI_MODEL).
# GEMINI_MODEL_TECH=
# GEMINI_MODEL_RANDOM=

# --- API keys: one Gemini API key per mode ---------------------------------
# Mode 1 (tech) and mode 2 (random) use different keys so that usage can be
# attributed and billed separately in the backend. They stay on the server: the
# browser never receives them.
GEMINI_API_KEY_TECH=
GEMINI_API_KEY_RANDOM=
# Optional: used by both modes when the per-mode key above is empty.
# GEMINI_API_KEY=
# Development only: force the fixed mock answer even when keys are configured.
# LLM_MOCK=true

# --- System prompts: one per mode ------------------------------------------
# Mode 1 · tech — the existing system prompt, sent as the system instruction of
# every tech conversation.
SYSTEM_PROMPT_TECH="You are a technical/research assistant. Only answer questions related to math and cs. Be concise, do not make assumptions, and do not answer any off-topic queries."

# Mode 2 · random — intentionally EMPTY: random mode is sent to the model with
# no system prompt at all. Fill this in only if you want to change that.
SYSTEM_PROMPT_RANDOM=

# (Optional, for reference) The prompt that used to live in lib/prompts.txt.
# Mode 2 has no system prompt, so this is only here as a copy/paste source:
# SYSTEM_PROMPT_RANDOM="Сначала исправьте грамматические ошибки, затем ответьте.\n\nКак исправить грамматику? (если по русскому)\n1. Мужской род для пользователя. Игнорируй букву «ё»: если вместо «ё» написано «е», считай это правильным и не исправляй.\n2. Перепиши предложение с исправлениями прямо в тексте:\n- Выдели неправильные слова ~~зачеркиванием~~ (тильда с обеих сторон)\n- Сразу после напиши правильное слово **жирным шрифтом** (звёздочки с обеих сторон)\n3. Знаки препинания исправляй или добавляй без выделений (не используй для них ~~зачеркивание~~ и **жирный шрифт**).\n\nПример:\nВвод: Я пошла в магазине и купила хлеб а потом пошла спать.\nВывод: Я ~~пошла~~ **пошел** в ~~магазине~~ **магазин** и ~~купила~~ **купил** хлеб, а потом ~~пошла~~ **пошел** спать.\n\nЕсли текст не на русском языке, или есть английские слова, отвечайте прямо и на русском языке."
