# llm.jimchen.me — environment configuration
#
# Copy this file to .env (or .env.local) and fill in the real values:
#   cp .env.example .env
#
# Every line is `export`-prefixed, so the file also works when sourced
# directly in a shell:  source .env

# ── Redis ────────────────────────────────────────────────────────────────────
export REDIS_URL=redis://localhost:6379

# ── Access password (production only — development test runs never ask for it)
export APP_PASSWORD=my_secure_password

# ── Gemini API keys ──────────────────────────────────────────────────────────
# Two separate API keys, one per mode, so each mode's usage is calculated and
# billed separately in the backend. The frontend never sees or picks these —
# it only knows the conversation's mode.
export GEMINI_API_KEY_TECH=your_tech_mode_gemini_api_key
export GEMINI_API_KEY_RANDOM=your_random_mode_gemini_api_key

# ── Prompts ──────────────────────────────────────────────────────────────────
# Mode 1 "tech" (the default) always runs with this system prompt.
# Mode 2 "random" never sends a system prompt at all.
export SYSTEM_PROMPT_TECH="You are a technical/research assistant. Only answer questions related to math and cs. Be concise, do not make assumptions, and do not answer any off-topic queries."
